# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is intentionally tracked (Phase 19 §19.19: a
# clean checkout needs it to know which vars to set) even though every
# real .env* is not.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma-installed agent skill docs (not part of the app)
/.claude/skills
/.windsurf/skills
/.agents/skills
/skills-lock.json

# local uploads (Phase 2+ storage)
/storage/uploads

/src/generated/prisma
