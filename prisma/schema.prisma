// AI Study Coach — Prisma schema
// Phase 1: foundation (User, Course, Document, DocumentChunk).
// Phase 2: document ingestion fields on Document/DocumentChunk.
// Phase 3: knowledge graph (Concept, ConceptSource, ConceptRelationship,
// Course.knowledgeStatus). Mastery/Question/Answer/Mistake/Review/AiUsageLog
// are defined for their FKs but their business logic ships in later phases
// (see spec §30).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses           Course[]
  masteries         StudentConceptMastery[]
  answers           Answer[]
  studentMistakes   StudentMistake[]
  reviews           Review[]
  aiUsageLogs       AiUsageLog[]
  learningAttempts  LearningAttempt[]
  knowledgeEvidence KnowledgeEvidence[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Course ingestion
// ---------------------------------------------------------------------------

enum CourseStatus {
  active
  archived
}

enum KnowledgeStatus {
  NOT_STARTED
  PROCESSING
  READY
  FAILED
}

model Course {
  id               String          @id @default(cuid())
  userId           String
  title            String
  description      String?
  status           CourseStatus    @default(active)
  knowledgeStatus  KnowledgeStatus @default(NOT_STARTED)
  knowledgeError   String?
  knowledgeBuiltAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  concepts  Concept[]

  @@index([userId])
  @@map("courses")
}

enum DocumentType {
  pdf
  text
  other
}

enum ProcessingStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model Document {
  id               String           @id @default(cuid())
  courseId         String
  filename         String
  originalFilename String
  mimeType         String
  fileSize         Int
  type             DocumentType
  storagePath      String
  extractedText    String?
  processingStatus ProcessingStatus @default(UPLOADED)
  processingError  String?
  pageCount        Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  course Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@index([courseId])
  @@map("documents")
}

model DocumentChunk {
  id         String                       @id @default(cuid())
  documentId String
  text       String
  chunkIndex Int
  tokenCount Int
  embedding  Unsupported("vector(1536)")?
  metadata   Json?
  createdAt  DateTime                     @default(now())

  document       Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  conceptSources ConceptSource[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

// ---------------------------------------------------------------------------
// Knowledge graph
//
// This is the COURSE's knowledge graph — what the material teaches — not the
// student's knowledge state (that's StudentConceptMastery, Phase 4). Do not
// add mastery fields here.
//
// Phase 1 sketched a dedicated `Prerequisite` table alongside `Concept`. This
// schema consolidates prerequisite edges into `ConceptRelationship` instead
// (relationshipType = "prerequisite") rather than keeping both: Phase 3's own
// spec defines relationshipType as an 8-value enum that includes
// "prerequisite", and maintaining two parallel representations of the same
// edge would mean keeping them in sync on every rebuild — a real risk to the
// idempotency guarantee (rerun-safe, no duplicates) required by this phase.
// A single evidence-backed, confidence-scored table is the simpler design.
//
// Direction convention for relationshipType = "prerequisite":
//   sourceConcept -> targetConcept means "sourceConcept is a prerequisite
//   for targetConcept" (source must be learned first; source is required to
//   understand target). Read services/knowledge.ts's getPrerequisitesOf() /
//   getDependentsOf() rather than reasoning about source/target directly.
// ---------------------------------------------------------------------------

model Concept {
  id             String   @id @default(cuid())
  courseId       String
  name           String
  normalizedName String
  description    String?
  difficulty     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  sources               ConceptSource[]
  relationshipsAsSource ConceptRelationship[] @relation("RelationshipSource")
  relationshipsAsTarget ConceptRelationship[] @relation("RelationshipTarget")

  masteries         StudentConceptMastery[]
  questions         Question[]
  studentMistakes   StudentMistake[]
  reviews           Review[]
  learningAttempts  LearningAttempt[]
  knowledgeEvidence KnowledgeEvidence[]

  // Prevents duplicate concepts within a course (spec §2, §11 dedup).
  @@unique([courseId, normalizedName])
  @@index([courseId])
  @@map("concepts")
}

/// Links a concept to the document chunk(s) it was extracted from, so every
/// concept is traceable back to its source material (spec §3).
model ConceptSource {
  id              String   @id @default(cuid())
  conceptId       String
  documentChunkId String
  relevance       Float    @default(1.0)
  evidence        String
  createdAt       DateTime @default(now())

  concept       Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  documentChunk DocumentChunk @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@unique([conceptId, documentChunkId])
  @@index([conceptId])
  @@index([documentChunkId])
  @@map("concept_sources")
}

enum RelationshipType {
  prerequisite
  contains
  related
  example_of
  contrasts_with
  causes
  part_of
  applies_to
}

model ConceptRelationship {
  id               String           @id @default(cuid())
  sourceConceptId  String
  targetConceptId  String
  relationshipType RelationshipType
  confidence       Float
  evidence         String
  /// Accepted (confidence in the "review" band) but not fully auto-trusted — see spec §15.
  needsReview      Boolean          @default(false)
  createdAt        DateTime         @default(now())

  sourceConcept Concept @relation("RelationshipSource", fields: [sourceConceptId], references: [id], onDelete: Cascade)
  targetConcept Concept @relation("RelationshipTarget", fields: [targetConceptId], references: [id], onDelete: Cascade)

  // Prevents duplicate edges of the same type between the same pair (idempotent rebuilds).
  @@unique([sourceConceptId, targetConceptId, relationshipType])
  @@index([sourceConceptId])
  @@index([targetConceptId])
  @@index([relationshipType])
  @@map("concept_relationships")
}

// ---------------------------------------------------------------------------
// Student model (Phase 4)
//
// Strictly separate from the course knowledge graph above: Concept /
// ConceptSource / ConceptRelationship describe what the material teaches,
// never what a student knows. Everything in this section is scoped to a
// (userId, conceptId) pair and answers "what does THIS student know."
//
// StudentConceptMastery rows are created lazily — on first evidence, not
// pre-populated for every concept. Absence of a row means UNKNOWN ("not
// enough evidence yet"), not "student doesn't know this." See
// src/lib/learning/mastery-engine.ts.
// ---------------------------------------------------------------------------

enum MasteryStatus {
  UNKNOWN
  LEARNING
  DEVELOPING
  STRONG
  MASTERED
  NEEDS_REMEDIATION
}

model StudentConceptMastery {
  id        String @id @default(cuid())
  userId    String
  conceptId String

  // Dimensional scores (0-1), never a single boolean mastered flag (spec §1).
  recallScore      Float @default(0)
  explanationScore Float @default(0)
  applicationScore Float @default(0)
  transferScore    Float @default(0)
  confidenceScore  Float @default(0)
  overallMastery   Float @default(0)

  exposureCount Int @default(0)
  attemptCount  Int @default(0)
  successCount  Int @default(0)
  failureCount  Int @default(0)
  hintCount     Int @default(0)
  revealCount   Int @default(0)

  status        MasteryStatus @default(UNKNOWN)
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastFailureAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  // One mastery row per student per concept (lazily created).
  @@unique([userId, conceptId])
  @@index([userId])
  @@index([conceptId])
  @@index([status])
  @@map("student_concept_mastery")
}

enum EvidenceSourceType {
  QUESTION
  TEACH_BACK
  SCENARIO
  EXAM
  DIAGNOSTIC
  MANUAL
}

enum EvidenceOutcome {
  SUCCESS
  PARTIAL
  FAILURE
}

/// A single, immutable, timestamped observation of a student's knowledge of
/// a concept — the raw signal that feeds mastery updates. Never overwritten
/// or deleted (spec §24); the ordered history of `score` values over time is
/// also what backs the "mastery over time" view (spec §22) — no separate
/// history table needed.
model KnowledgeEvidence {
  id         String             @id @default(cuid())
  userId     String
  conceptId  String
  sourceType EvidenceSourceType
  /// Polymorphic reference (e.g. a LearningAttempt id) — intentionally not a
  /// strict FK, since evidence can originate from sources this phase doesn't
  /// define yet (spec §31) or be MANUAL with no source at all.
  sourceId   String?
  outcome    EvidenceOutcome
  score      Float
  confidence Float?
  notes      String?
  createdAt  DateTime           @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conceptId])
  @@index([createdAt])
  @@map("knowledge_evidence")
}

enum LearningActivityType {
  RECALL
  EXPLANATION
  APPLICATION
  TRANSFER
  TEACH_BACK
  SCENARIO
  EXAM
  DIAGNOSTIC
}

/// Full history of every learning interaction a student had with a concept.
/// Never overwritten (spec §5) — this is the append-only log that
/// KnowledgeEvidence and StudentMistake rows are derived from.
model LearningAttempt {
  id              String               @id @default(cuid())
  userId          String
  conceptId       String
  activityType    LearningActivityType
  difficulty      Int                  @default(1)
  score           Float?
  correctness     Float?
  confidence      Float?
  usedHint        Boolean              @default(false)
  revealedAnswer  Boolean              @default(false)
  durationSeconds Int?
  createdAt       DateTime             @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  mistakes StudentMistake[]

  @@index([userId])
  @@index([conceptId])
  @@index([createdAt])
  @@map("learning_attempts")
}

// ---------------------------------------------------------------------------
// Questions & answers
// ---------------------------------------------------------------------------

enum QuestionType {
  recall
  explain
  compare
  apply
  scenario
  troubleshooting
  teach_back
  oral
  written_exam
  transfer
}

model Question {
  id               String       @id @default(cuid())
  conceptId        String
  type             QuestionType
  difficulty       Int          @default(1)
  prompt           String
  expectedAnswer   String?
  rubric           Json?
  sourceReferences Json?
  createdAt        DateTime     @default(now())

  concept Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([conceptId])
  @@map("questions")
}

model Answer {
  id                     String   @id @default(cuid())
  questionId             String
  userId                 String
  answerText             String
  score                  Float?
  correctness            Float?
  reasoningQuality       Float?
  completeness           Float?
  confidence             Float?
  feedback               String?
  detectedMisconceptions Json?
  missingConcepts        Json?
  createdAt              DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
  @@map("answers")
}

// ---------------------------------------------------------------------------
// Mistakes
//
// Critical distinction (spec §7): a knowledge GAP ("I don't know X") needs
// teaching; a MISCONCEPTION ("I know X, incorrectly") needs confrontation
// with a counterexample. `category` keeps them distinguishable — never
// collapse both into a single "wrong answer" bucket.
// ---------------------------------------------------------------------------

enum StudentMistakeCategory {
  FACTUAL_ERROR
  CONCEPTUAL_GAP
  MISCONCEPTION
  PREREQUISITE_GAP
  REASONING_ERROR
  INCOMPLETE_ANSWER
  APPLICATION_FAILURE
  TRANSFER_FAILURE
  TERMINOLOGY_CONFUSION
  CARELESS_ERROR
}

enum MistakeSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Resolution is a review-tracking flag only — marking a mistake resolved
/// must NOT itself change mastery (spec §23); mastery only moves on new
/// evidence. Rows are never deleted, even once resolved (spec §24).
model StudentMistake {
  id          String                 @id @default(cuid())
  userId      String
  conceptId   String
  attemptId   String?
  category    StudentMistakeCategory
  description String
  severity    MistakeSeverity        @default(MEDIUM)
  resolved    Boolean                @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  attempt LearningAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([conceptId])
  @@index([resolved])
  @@map("student_mistakes")
}

// ---------------------------------------------------------------------------
// Spaced repetition
// ---------------------------------------------------------------------------

enum ReviewOutcome {
  again
  hard
  good
  easy
}

model Review {
  id          String         @id @default(cuid())
  userId      String
  conceptId   String
  scheduledAt DateTime
  completedAt DateTime?
  outcome     ReviewOutcome?
  interval    Float          @default(0)
  ease        Float          @default(2.5)
  repetitions Int            @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([conceptId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Cost control / observability
// ---------------------------------------------------------------------------

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  model            String
  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Float
  requestType      String
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}
