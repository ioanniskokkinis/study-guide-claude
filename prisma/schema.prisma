// AI Study Coach — Prisma schema
// Phase 1: foundation (User, Course, Document, DocumentChunk).
// Phase 2: document ingestion fields on Document/DocumentChunk.
// Phase 3: knowledge graph (Concept, ConceptSource, ConceptRelationship,
// Course.knowledgeStatus). Mastery/Question/Answer/Mistake/Review/AiUsageLog
// are defined for their FKs but their business logic ships in later phases
// (see spec §30).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses               Course[]
  masteries             StudentConceptMastery[]
  answers               Answer[]
  studentMistakes       StudentMistake[]
  aiUsageLogs           AiUsageLog[]
  learningAttempts      LearningAttempt[]
  knowledgeEvidence     KnowledgeEvidence[]
  studySessions         StudySession[]
  learningGoals         LearningGoal[]
  adaptiveDecisionLogs  AdaptiveDecisionLog[]
  tutorSessions         TutorSession[]
  studentMisconceptions StudentMisconception[]
  exams                 Exam[]
  examAnswers           ExamAnswer[]
  reviewItems           ReviewItem[]
  reviewEvents          ReviewEvent[]
  ttsUsageLogs          TtsUsageLog[]
  studyRoadmaps         StudyRoadmap[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Course ingestion
// ---------------------------------------------------------------------------

enum CourseStatus {
  active
  archived
}

enum KnowledgeStatus {
  NOT_STARTED
  /// Build accepted but not yet running — the atomic "claim" state a concurrent build request is rejected against (production-hardening phase §A1/§L).
  QUEUED
  PROCESSING
  READY
  FAILED
}

model Course {
  id               String          @id @default(cuid())
  userId           String
  title            String
  description      String?
  status           CourseStatus    @default(active)
  knowledgeStatus  KnowledgeStatus @default(NOT_STARTED)
  knowledgeError   String?
  knowledgeBuiltAt DateTime?
  /// 0-100 — real progress from processed batches, never a fake timer (production-hardening phase §A5).
  knowledgeProgress Int @default(0)
  /// Machine-readable current stage: loading/extracting-concepts/normalizing-concepts/semantic-merge/relationships/prerequisites/validation/saving/complete/failed.
  knowledgeStage String?
  /// Human-readable progress line for the UI, e.g. "Extracting concepts — batch 12/30".
  knowledgeStageMessage String?
  knowledgeStartedAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents            Document[]
  folders              Folder[]
  concepts             Concept[]
  questions            Question[]
  studySessions        StudySession[]
  learningGoals        LearningGoal[]
  adaptiveDecisionLogs AdaptiveDecisionLog[]
  tutorSessions        TutorSession[]
  exams                Exam[]
  reviewItems          ReviewItem[]
  studyRoadmaps        StudyRoadmap[]

  @@index([userId])
  @@map("courses")
}

enum DocumentType {
  pdf
  text
  other
}

enum ProcessingStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model Document {
  id               String           @id @default(cuid())
  courseId         String
  /// Optional Knowledge Hub folder (Phase 15) — null means "directly under the course," same as every document before this phase.
  folderId         String?
  filename         String
  originalFilename String
  mimeType         String
  fileSize         Int
  type             DocumentType
  storagePath      String
  extractedText    String?
  processingStatus ProcessingStatus @default(UPLOADED)
  processingError  String?
  pageCount        Int?
  /// SHA-256 of the raw uploaded bytes (Phase 15 §13) — duplicate detection within a course. Null for documents uploaded before this phase (backfill not required; they simply never match as duplicates).
  contentHash      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  course Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  folder Folder?         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  roadmapScopes      StudyRoadmapDocument[]
  roadmapItemSources StudyRoadmapItem[]

  @@index([courseId])
  @@index([folderId])
  @@index([courseId, contentHash])
  @@map("documents")
}

/// Knowledge Hub folder (Phase 15 §3-5) — a simple, ownership-scoped tree via
/// `parentFolderId`. Deletion cascades to child folders and their documents
/// (same "hard delete, no soft-delete/trash" convention this app has used
/// since Phase 1 for Course/Document), so the delete-folder API route
/// requires an explicit confirmation the same way DeleteCourseButton /
/// DeleteDocumentButton already do — see src/lib/services/folders.ts for the
/// circular-move and cross-course guards enforced before any write.
model Folder {
  id             String   @id @default(cuid())
  courseId       String
  parentFolderId String?
  name           String
  /// Manual display ordering within a parent (Phase 15 §4) — ties broken by createdAt.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parentFolder Folder?    @relation("FolderChildren", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders Folder[]   @relation("FolderChildren")
  documents    Document[]

  roadmapScopes StudyRoadmap[]

  @@index([courseId])
  @@index([parentFolderId])
  @@map("folders")
}

model DocumentChunk {
  id         String                       @id @default(cuid())
  documentId String
  text       String
  chunkIndex Int
  tokenCount Int
  embedding  Unsupported("vector(1536)")?
  metadata   Json?
  createdAt  DateTime                     @default(now())

  document       Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  conceptSources ConceptSource[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

// ---------------------------------------------------------------------------
// Knowledge graph
//
// This is the COURSE's knowledge graph — what the material teaches — not the
// student's knowledge state (that's StudentConceptMastery, Phase 4). Do not
// add mastery fields here.
//
// Phase 1 sketched a dedicated `Prerequisite` table alongside `Concept`. This
// schema consolidates prerequisite edges into `ConceptRelationship` instead
// (relationshipType = "prerequisite") rather than keeping both: Phase 3's own
// spec defines relationshipType as an 8-value enum that includes
// "prerequisite", and maintaining two parallel representations of the same
// edge would mean keeping them in sync on every rebuild — a real risk to the
// idempotency guarantee (rerun-safe, no duplicates) required by this phase.
// A single evidence-backed, confidence-scored table is the simpler design.
//
// Direction convention for relationshipType = "prerequisite":
//   sourceConcept -> targetConcept means "sourceConcept is a prerequisite
//   for targetConcept" (source must be learned first; source is required to
//   understand target). Read services/knowledge.ts's getPrerequisitesOf() /
//   getDependentsOf() rather than reasoning about source/target directly.
// ---------------------------------------------------------------------------

model Concept {
  id             String   @id @default(cuid())
  courseId       String
  name           String
  normalizedName String
  description    String?
  difficulty     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  sources               ConceptSource[]
  relationshipsAsSource ConceptRelationship[] @relation("RelationshipSource")
  relationshipsAsTarget ConceptRelationship[] @relation("RelationshipTarget")

  masteries             StudentConceptMastery[]
  questions             Question[]
  studentMistakes       StudentMistake[]
  learningAttempts      LearningAttempt[]
  knowledgeEvidence     KnowledgeEvidence[]
  adaptiveDecisionLogs  AdaptiveDecisionLog[]
  tutorSessions         TutorSession[]
  studentMisconceptions StudentMisconception[]
  tutorSessionOutcomes  TutorSessionOutcome[]
  examQuestions         ExamQuestion[]
  reviewItems           ReviewItem[]
  reviewEvents          ReviewEvent[]
  roadmapItems          StudyRoadmapItem[]

  // Prevents duplicate concepts within a course (spec §2, §11 dedup).
  @@unique([courseId, normalizedName])
  @@index([courseId])
  @@map("concepts")
}

/// Links a concept to the document chunk(s) it was extracted from, so every
/// concept is traceable back to its source material (spec §3).
model ConceptSource {
  id              String   @id @default(cuid())
  conceptId       String
  documentChunkId String
  relevance       Float    @default(1.0)
  evidence        String
  createdAt       DateTime @default(now())

  concept       Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  documentChunk DocumentChunk @relation(fields: [documentChunkId], references: [id], onDelete: Cascade)

  @@unique([conceptId, documentChunkId])
  @@index([conceptId])
  @@index([documentChunkId])
  @@map("concept_sources")
}

enum RelationshipType {
  prerequisite
  contains
  related
  example_of
  contrasts_with
  causes
  part_of
  applies_to
}

model ConceptRelationship {
  id               String           @id @default(cuid())
  sourceConceptId  String
  targetConceptId  String
  relationshipType RelationshipType
  confidence       Float
  evidence         String
  /// Accepted (confidence in the "review" band) but not fully auto-trusted — see spec §15.
  needsReview      Boolean          @default(false)
  createdAt        DateTime         @default(now())

  sourceConcept Concept @relation("RelationshipSource", fields: [sourceConceptId], references: [id], onDelete: Cascade)
  targetConcept Concept @relation("RelationshipTarget", fields: [targetConceptId], references: [id], onDelete: Cascade)

  // Prevents duplicate edges of the same type between the same pair (idempotent rebuilds).
  @@unique([sourceConceptId, targetConceptId, relationshipType])
  @@index([sourceConceptId])
  @@index([targetConceptId])
  @@index([relationshipType])
  @@map("concept_relationships")
}

// ---------------------------------------------------------------------------
// Student model (Phase 4)
//
// Strictly separate from the course knowledge graph above: Concept /
// ConceptSource / ConceptRelationship describe what the material teaches,
// never what a student knows. Everything in this section is scoped to a
// (userId, conceptId) pair and answers "what does THIS student know."
//
// StudentConceptMastery rows are created lazily — on first evidence, not
// pre-populated for every concept. Absence of a row means UNKNOWN ("not
// enough evidence yet"), not "student doesn't know this." See
// src/lib/learning/mastery-engine.ts.
// ---------------------------------------------------------------------------

enum MasteryStatus {
  UNKNOWN
  LEARNING
  DEVELOPING
  STRONG
  MASTERED
  NEEDS_REMEDIATION
}

model StudentConceptMastery {
  id        String @id @default(cuid())
  userId    String
  conceptId String

  // Dimensional scores (0-1), never a single boolean mastered flag (spec §1).
  recallScore      Float @default(0)
  explanationScore Float @default(0)
  applicationScore Float @default(0)
  transferScore    Float @default(0)
  confidenceScore  Float @default(0)
  overallMastery   Float @default(0)

  exposureCount Int @default(0)
  attemptCount  Int @default(0)
  successCount  Int @default(0)
  failureCount  Int @default(0)
  hintCount     Int @default(0)
  revealCount   Int @default(0)

  /// Signed (Phase 2 §A/§B): positive = consecutive correct, negative = consecutive incorrect, 0 = none/broken by a PARTIAL outcome.
  currentStreak Int @default(0)
  /// Best (highest) consecutive-correct streak ever reached for this concept — never decreases.
  bestStreak    Int @default(0)

  status        MasteryStatus @default(UNKNOWN)
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastFailureAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  // One mastery row per student per concept (lazily created).
  @@unique([userId, conceptId])
  @@index([userId])
  @@index([conceptId])
  @@index([status])
  @@map("student_concept_mastery")
}

enum EvidenceSourceType {
  QUESTION
  TEACH_BACK
  SCENARIO
  EXAM
  DIAGNOSTIC
  MANUAL
}

enum EvidenceOutcome {
  SUCCESS
  PARTIAL
  FAILURE
}

/// A single, immutable, timestamped observation of a student's knowledge of
/// a concept — the raw signal that feeds mastery updates. Never overwritten
/// or deleted (spec §24); the ordered history of `score` values over time is
/// also what backs the "mastery over time" view (spec §22) — no separate
/// history table needed.
model KnowledgeEvidence {
  id         String             @id @default(cuid())
  userId     String
  conceptId  String
  sourceType EvidenceSourceType
  /// Polymorphic reference (e.g. a LearningAttempt id) — intentionally not a
  /// strict FK, since evidence can originate from sources this phase doesn't
  /// define yet (spec §31) or be MANUAL with no source at all.
  sourceId   String?
  outcome    EvidenceOutcome
  score      Float
  confidence Float?
  notes      String?
  createdAt  DateTime           @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conceptId])
  @@index([createdAt])
  @@map("knowledge_evidence")
}

enum LearningActivityType {
  RECALL
  EXPLANATION
  APPLICATION
  TRANSFER
  TEACH_BACK
  SCENARIO
  EXAM
  DIAGNOSTIC
}

/// Full history of every learning interaction a student had with a concept.
/// Never overwritten (spec §5) — this is the append-only log that
/// KnowledgeEvidence and StudentMistake rows are derived from.
model LearningAttempt {
  id              String               @id @default(cuid())
  userId          String
  conceptId       String
  activityType    LearningActivityType
  difficulty      Int                  @default(1)
  score           Float?
  correctness     Float?
  confidence      Float?
  usedHint        Boolean              @default(false)
  revealedAnswer  Boolean              @default(false)
  durationSeconds Int?
  createdAt       DateTime             @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  mistakes              StudentMistake[]
  answers               Answer[]
  studySessionQuestions StudySessionQuestion[]
  examAnswers           ExamAnswer[]
  reviewEvents          ReviewEvent[]

  @@index([userId])
  @@index([conceptId])
  @@index([createdAt])
  @@map("learning_attempts")
}

// ---------------------------------------------------------------------------
// Questions & answers (Phase 5)
//
// A Question is course content (grounded in real source chunks, reusable
// across students/sessions) — like Concept, it belongs to course knowledge,
// not to any one student. An Answer is one student's attempt at one
// Question, holding both the raw submission and (once evaluation succeeds)
// the AI evaluator's structured result. Answer is deliberately NOT the
// source of truth for mastery — recordLearningOutcome() (Phase 4) is, via
// the LearningAttempt an Answer links to once evaluated (spec §21).
// ---------------------------------------------------------------------------

enum QuestionType {
  RECALL
  EXPLAIN
  COMPARE
  APPLY
  TRANSFER
}

model Question {
  id               String       @id @default(cuid())
  courseId         String
  conceptId        String
  type             QuestionType
  difficulty       Int          @default(1)
  prompt           String
  /// Lowercased/whitespace-collapsed prompt, used for duplicate detection
  /// (spec §24) without an embedding index — see question-generator.ts.
  normalizedPrompt String
  expectedAnswer   String?
  rubric           Json?
  sourceReferences Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  answers               Answer[]
  studySessionQuestions StudySessionQuestion[]

  @@index([conceptId])
  @@index([courseId])
  @@index([conceptId, normalizedPrompt])
  @@map("questions")
}

/// Phase 17 §19 — the answer/evaluate split's terminal-state tracker. PENDING
/// means the answer is persisted but Claude hasn't judged it yet (or a prior
/// attempt is being retried); COMPLETED/FAILED/TIMEOUT are all terminal —
/// the UI must never be stuck showing "evaluating" once one of these is set.
enum AnswerEvaluationStatus {
  PENDING
  /// Claimed by an in-flight evaluation attempt (Phase 19 §19.6) — a
  /// conditional updateMany transitions PENDING/FAILED/TIMEOUT -> EVALUATING
  /// atomically before the Claude call starts, so two concurrent evaluate
  /// requests for the same answer can never both call recordLearningOutcome()
  /// and double-write mastery. A claim stuck here (crashed mid-flight) is
  /// reclaimable once stale — see STALE_EVALUATION_CLAIM_MS in study-session.ts.
  EVALUATING
  COMPLETED
  FAILED
  TIMEOUT
}

model Answer {
  id                String  @id @default(cuid())
  questionId        String
  userId            String
  sessionQuestionId String?

  answerText String
  /// Normalized 0-1 self-reported confidence, same representation as LearningAttempt.confidence (Phase 4).
  confidence Float?

  // Filled in once AI evaluation succeeds; null while pending or if evaluation failed.
  score                    Float?
  /// Reuses Phase 4's tri-state SUCCESS/PARTIAL/FAILURE outcome enum — "correct" is
  /// never collapsed to a boolean (spec §12), and this maps 1:1 onto recordLearningOutcome's outcome.
  correctness              EvidenceOutcome?
  reasoningQuality         Float?
  completeness             Float?
  feedback                 String?
  correctAnswer            String?
  strengths                Json?
  missingPoints            Json?
  /// Evaluator's raw error/misconception findings, kept as a snapshot for
  /// audit — the StudentMistake rows created via recordLearningOutcome are
  /// the authoritative record, not this column.
  errors                   Json?
  misconceptions           Json?
  needsRemediation         Boolean          @default(false)
  /// Set only if the evaluator flagged a prerequisite gap AND it was
  /// validated against a real edge in this course's knowledge graph
  /// (spec §14) — never trusted from the model directly.
  prerequisiteGapConceptId String?

  usedHint       Boolean @default(false)
  revealedAnswer Boolean @default(false)

  durationSeconds Int?
  /// Set if AI evaluation failed/timed out — the answer is preserved
  /// so nothing is lost, and evaluation can be retried (Phase 17 §17/§37).
  evaluationError String?
  /// State tracker for the answer/evaluate split (Phase 17 §19): PENDING ->
  /// (claimed) EVALUATING -> COMPLETED/FAILED/TIMEOUT. Evaluation and
  /// recordLearningOutcome() only ever run once per answer — the atomic
  /// PENDING/FAILED/TIMEOUT -> EVALUATING claim (Phase 19 §19.6) makes this
  /// safe even under concurrent retry requests, not just sequential ones.
  evaluationStatus AnswerEvaluationStatus @default(PENDING)
  /// Set once recordLearningOutcome() has run for this answer — the resulting attempt/evidence/mastery update.
  attemptId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question        Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionQuestion StudySessionQuestion? @relation(fields: [sessionQuestionId], references: [id], onDelete: SetNull)
  attempt         LearningAttempt?      @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([sessionQuestionId])
  @@index([questionId])
  @@index([userId])
  @@map("answers")
}

// ---------------------------------------------------------------------------
// Active Recall sessions (Phase 5)
//
// A StudySession is one continuous study activity; StudySessionQuestion
// instances record which questions were shown, in what order, and the
// ephemeral hint/reveal state accumulated before the student finally
// submits (at which point it links to the resulting Answer/LearningAttempt).
// Reconstructable after a page refresh entirely from these rows (spec §21).
// ---------------------------------------------------------------------------

enum StudySessionMode {
  ACTIVE_RECALL
  /// Phase 9: a session driven by the spaced-repetition due-queue instead of the adaptive engine's own concept choice — see src/lib/review/review-orchestrator.ts. Reuses every other StudySession/StudySessionQuestion/Answer mechanic unchanged (spec §10, §13).
  REVIEW
}

enum StudySessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model StudySession {
  id       String             @id @default(cuid())
  userId   String
  courseId String
  mode     StudySessionMode   @default(ACTIVE_RECALL)
  status   StudySessionStatus @default(ACTIVE)

  /// Configured session length (spec §27) — how many questions this session targets.
  targetLength      Int
  questionsAnswered Int @default(0)
  questionsCorrect  Int @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions StudySessionQuestion[]

  @@index([userId])
  @@index([courseId])
  @@index([userId, status])
  @@map("study_sessions")
}

model StudySessionQuestion {
  id         String @id @default(cuid())
  sessionId  String
  questionId String
  /// 1-based order within the session.
  position   Int

  presentedAt DateTime  @default(now())
  answeredAt  DateTime?
  attemptId   String?
  /// Concise, product-level explanation of why this concept was chosen (spec §32) — persisted so it survives a page refresh.
  reason      String?

  /// Hint/reveal state while this question is still unanswered; folded into
  /// the LearningAttempt (usedHint/revealedAnswer) once submitted (spec §18-19).
  hintsUsed Int     @default(0)
  revealed  Boolean @default(false)

  createdAt DateTime @default(now())

  session  StudySession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempt  LearningAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  answer   Answer?

  @@unique([sessionId, position])
  /// Phase 17 §10 — the same question can never be attached to one session
  /// twice, including under the race between two concurrent prefetch calls
  /// (or a live "next" call landing at the same moment as a background
  /// top-up) both reusing the same existing Question row. The database is
  /// the single source of truth here, not an in-app lock.
  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@map("study_session_questions")
}

// ---------------------------------------------------------------------------
// Mistakes
//
// Critical distinction (spec §7): a knowledge GAP ("I don't know X") needs
// teaching; a MISCONCEPTION ("I know X, incorrectly") needs confrontation
// with a counterexample. `category` keeps them distinguishable — never
// collapse both into a single "wrong answer" bucket.
// ---------------------------------------------------------------------------

enum StudentMistakeCategory {
  FACTUAL_ERROR
  CONCEPTUAL_GAP
  MISCONCEPTION
  PREREQUISITE_GAP
  REASONING_ERROR
  INCOMPLETE_ANSWER
  APPLICATION_FAILURE
  TRANSFER_FAILURE
  TERMINOLOGY_CONFUSION
  CARELESS_ERROR
}

enum MistakeSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Resolution is a review-tracking flag only — marking a mistake resolved
/// must NOT itself change mastery (spec §23); mastery only moves on new
/// evidence. Rows are never deleted, even once resolved (spec §24).
model StudentMistake {
  id          String                 @id @default(cuid())
  userId      String
  conceptId   String
  attemptId   String?
  category    StudentMistakeCategory
  description String
  severity    MistakeSeverity        @default(MEDIUM)
  resolved    Boolean                @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  attempt LearningAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([conceptId])
  @@index([resolved])
  @@map("student_mistakes")
}

// ---------------------------------------------------------------------------
// Spaced repetition (Phase 9)
//
// Replaces the Phase 1 `Review` stub — that model conflated a persistent
// per-concept schedule with a single scheduled event and had no history
// table, which can't satisfy "review history must never be overwritten"
// (spec §4). It was never referenced by any business logic (grep-confirmed
// before this rewrite), so this is a straight replacement, not a migration
// of live data.
//
// ReviewItem is the persistent, one-row-per-(student, concept) schedule —
// lazily created the first time a concept has real learning evidence
// (mirrors StudentConceptMastery's lazy-creation pattern, spec §3).
// ReviewEvent is the append-only history of every completed review (spec
// §4) — never updated or deleted, one row per rating.
//
// The scheduler itself (src/lib/review/scheduler.ts) is a pure, deterministic
// function; Claude is never involved in choosing a review date (spec §2).
// `interval`/`stability` are both persisted (rather than collapsing to one
// SM-2-style "ease") because they answer different questions: `stability`
// is the model's current estimate of how many days this memory will hold
// before it needs reinforcing, `interval` is the schedule gap actually
// applied (normally derived from stability, kept distinct so future tuning
// — fuzzing, rounding, per-mode caps — can diverge them without a schema
// change). `difficulty` is a 1-5 per-item difficulty estimate on the same
// scale used everywhere else in the app (Concept.difficulty,
// Question.difficulty, ExamQuestion.difficulty) rather than a separate
// ease-factor scale, so it's directly usable as a question-generation
// difficulty without conversion.
// ---------------------------------------------------------------------------

/// NEW: never reviewed. LEARNING: still in its first graduation cycle
/// (spec §5's "repetition count"). REVIEW: graduated to long intervals.
/// RELEARNING: lapsed out of REVIEW and is re-graduating.
enum ReviewItemStatus {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/// Self-rated recall quality (spec §4, §6) — Claude never assigns this, only the student does.
enum ReviewOutcome {
  AGAIN
  HARD
  GOOD
  EASY
}

/// Where a ReviewEvent originated — informational only, never branches scheduling logic (the algorithm is the same regardless of source).
enum ReviewEventSource {
  REVIEW_SESSION
}

model ReviewItem {
  id        String @id @default(cuid())
  userId    String
  /// Denormalized from concept.courseId so due-review queries never need a join through Concept (spec §17-18's course-scoped due query is on the hot path).
  courseId  String
  conceptId String

  status ReviewItemStatus @default(NEW)

  /// Days until the next scheduled review, as actually applied (may differ slightly from `stability` — see model comment above).
  interval   Float @default(0)
  /// The scheduler's current estimate, in days, of how long this memory will hold before retrieval becomes unreliable.
  stability  Float @default(0)
  /// 1-5, same scale as Concept/Question/ExamQuestion difficulty — higher means this item has been harder for this student to recall.
  difficulty Float @default(3)

  /// Consecutive successful (non-AGAIN) reviews since the last lapse — resets to 0 on AGAIN (spec §6).
  repetitionCount Int @default(0)
  /// Total AGAIN outcomes ever recorded for this item — cumulative, never decremented (spec §6).
  lapseCount      Int @default(0)

  lastReviewedAt DateTime?
  nextReviewAt   DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  concept Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  events  ReviewEvent[]

  /// One review schedule per student per concept (lazily created) — the canonical due-state query key (spec §7, §18).
  @@unique([userId, conceptId])
  @@index([userId, nextReviewAt])
  @@index([userId, conceptId])
  @@index([courseId])
  @@map("review_items")
}

/// Immutable history of every completed review (spec §4) — never updated after creation. `attemptId` is unique and required: every review event is created from exactly one evaluated LearningAttempt (the answer that was rated), which doubles as the idempotency key for review submission (spec §21 — retrying the same rating request finds the existing event instead of rescheduling twice).
model ReviewEvent {
  id           String @id @default(cuid())
  reviewItemId String
  userId       String
  conceptId    String

  outcome          ReviewOutcome
  previousInterval Float
  newInterval      Float
  source           ReviewEventSource @default(REVIEW_SESSION)

  /// The LearningAttempt (via recordLearningOutcome) this rating was given for — never a second, parallel evidence path (spec §9, §21).
  attemptId String @unique

  reviewedAt DateTime @default(now())

  reviewItem ReviewItem      @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept    Concept         @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  attempt    LearningAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([reviewItemId])
  @@index([userId, reviewedAt])
  @@map("review_events")
}

// ---------------------------------------------------------------------------
// Adaptive learning engine (Phase 6)
//
// The engine itself (src/lib/learning/adaptive-engine.ts) is deterministic
// and reads entirely from the models above (mastery, attempts, mistakes,
// prerequisites) — nothing here duplicates that data. These two models
// exist only for what didn't already have a home: a lightweight learning
// goal a student can set, and an audit trail of what the engine decided
// and why (spec §43-44), separate from WHY the underlying data looked the
// way it did.
// ---------------------------------------------------------------------------

enum LearningGoalType {
  EXAM
  MASTER_COURSE
  CERTIFICATION
  GENERAL
}

model LearningGoal {
  id               String           @id @default(cuid())
  userId           String
  courseId         String
  type             LearningGoalType
  /// Relevant for EXAM-type goals; drives the urgency curve in goal-relevance scoring (spec §16).
  targetDate       DateTime?
  /// Concept ids this goal specifically emphasizes; null/empty means "the whole course" (spec §15 — not a full calendar planner).
  targetConceptIds Json?
  priority         Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
  @@map("learning_goals")
}

/// Mirrors the adaptive engine's ActionType union (src/lib/learning/adaptive/types.ts).
enum AdaptiveActionType {
  ACTIVE_RECALL
  REMEDIATION
  PREREQUISITE_REVIEW
  REVIEW
  CHALLENGE
  REST
}

/// Mirrors the adaptive engine's ReasonType union.
enum AdaptiveReasonType {
  PREREQUISITE_GAP
  RECENT_MISTAKE
  MISCONCEPTION
  REPEATED_FAILURE
  FORGETTING_RISK
  WEAKNESS
  GOAL_RELEVANCE
  SUCCESS_STREAK
  NO_DATA
  GENERAL
}

/// One row per getNextLearningAction() call — enough to reconstruct what
/// was recommended and why (spec §44), without storing raw scoring
/// internals or anything AI-related (the engine makes zero Claude calls).
/// `accepted` is set only for the small subset of calls that are genuine
/// user-facing recommendation moments (the study dashboard's Start /
/// Study-something-else buttons) — internal Active Recall continuations
/// leave it null, since there's no separate accept/reject UX for those.
model AdaptiveDecisionLog {
  id            String             @id @default(cuid())
  userId        String
  courseId      String
  conceptId     String
  actionType    AdaptiveActionType
  priority      Float
  reasonType    AdaptiveReasonType
  reasonMessage String
  accepted      Boolean?
  createdAt     DateTime           @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
  @@index([createdAt])
  @@map("adaptive_decision_logs")
}

// ---------------------------------------------------------------------------
// Intelligent tutor engine (Phase 7)
//
// A TutorSession is a multi-turn conversation on one concept, distinct from
// a Phase 5 StudySession (single question/answer turns): it tracks Socratic
// depth, hint level, and mode across many TutorMessage rows. The engine
// itself (src/lib/tutor/) is a deterministic decision layer over this state
// plus the Phase 4 student model and the Phase 6 AdaptiveLearningEngine —
// nothing here duplicates mastery, prerequisite, or difficulty logic.
// ---------------------------------------------------------------------------

enum TutorMode {
  SOCRATIC
  TEACH_BACK
  REMEDIATION
}

enum TutorSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

/// Mirrors the TutorEngine's TutorDecision action union (src/lib/tutor/types.ts).
enum TutorDecisionAction {
  ASK_QUESTION
  ASK_FOLLOWUP
  GIVE_HINT
  GIVE_EXPLANATION
  SIMPLIFY
  DEEPEN
  CHECK_PREREQUISITE
  REMEDIATE
  TEACH_BACK
  INCREASE_DIFFICULTY
  DECREASE_DIFFICULTY
  COMPLETE
}

model TutorSession {
  id          String               @id @default(cuid())
  userId      String
  courseId    String
  conceptId   String
  mode        TutorMode            @default(SOCRATIC)
  status      TutorSessionStatus   @default(ACTIVE)
  /// The last TutorDecision action taken, so the UI/orchestrator can resume after a refresh without replaying history.
  currentStep TutorDecisionAction?

  /// Socratic questioning depth (spec §9) — capped at MAX_SOCRATIC_DEPTH (4).
  socraticDepth Int @default(0)
  /// 0 = no hint requested yet on the current open question; 1-3 = HINT_1..HINT_3; 4 = REVEAL.
  hintLevel     Int @default(0)
  difficulty    Int @default(1)

  /// Consecutive independent (non-revealed) correct responses on this session's concept — drives the completion criteria (spec §49).
  consecutiveCorrect      Int     @default(0)
  /// Consecutive non-correct responses on this session's concept — drives the repeated-failure -> REMEDIATE transition (spec §10, §15).
  consecutiveIncorrect    Int     @default(0)
  questionsAnswered       Int     @default(0)
  hintsUsedTotal          Int     @default(0)
  /// True while the most recently revealed answer's mandatory retrieval follow-up (spec §46-47) hasn't been asked yet.
  answerRevealed          Boolean @default(false)
  /// Last explanation strategy used (analogy/example/counterexample/step-by-step/compare-contrast) — never repeated back-to-back (spec §28).
  lastExplanationStrategy String?
  /// Running count of Claude calls made for this session (spec §54, optional cost tracking).
  aiCallCount             Int     @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  messages TutorMessage[]
  outcome  TutorSessionOutcome?

  @@index([userId, courseId])
  @@index([userId, status])
  @@map("tutor_sessions")
}

enum TutorMessageRole {
  TUTOR
  STUDENT
  SYSTEM
}

enum TutorMessageType {
  QUESTION
  FOLLOWUP
  HINT
  EXPLANATION
  FEEDBACK
  TEACH_BACK_PROMPT
  REMEDIATION
  COMPLETION
}

/// Persists only what's needed to reconstruct the conversation and its
/// evidence trail (spec §33) — never raw prompts or chain-of-thought.
model TutorMessage {
  id          String           @id @default(cuid())
  sessionId   String
  role        TutorMessageRole
  content     String
  messageType TutorMessageType
  /// Concise structured metadata (e.g. decision action, hint level, classification) — never hidden reasoning.
  metadata    Json?
  createdAt   DateTime         @default(now())

  session TutorSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  audio   TutorMessageAudio[]

  @@index([sessionId])
  @@map("tutor_messages")
}

/// A misconception is never cleared by a single correct answer (spec §13) —
/// `confidence` decays only as independent evidence accumulates, tracked via
/// `correctSinceCount`, and `resolved` flips only once both cross their
/// thresholds (see src/lib/tutor/misconceptions.ts).
model StudentMisconception {
  id                String          @id @default(cuid())
  userId            String
  conceptId         String
  description       String
  severity          MistakeSeverity @default(MEDIUM)
  /// 0-1; starts high on detection, decreases with independent correct evidence.
  confidence        Float           @default(1.0)
  /// Number of times this misconception has been (re-)detected.
  occurrenceCount   Int             @default(1)
  /// Independent correct responses on this concept since the misconception was last (re-)detected.
  correctSinceCount Int             @default(0)
  firstDetectedAt   DateTime        @default(now())
  lastDetectedAt    DateTime        @default(now())
  resolved          Boolean         @default(false)
  resolvedAt        DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([userId, conceptId])
  @@index([resolved])
  @@map("student_misconceptions")
}

/// Written once a TutorSession completes (spec §50) — masteryDelta is read
/// back from the StudentConceptMastery change recordLearningOutcome() already
/// produced, never invented by the tutor itself.
model TutorSessionOutcome {
  id                    String   @id @default(cuid())
  sessionId             String   @unique
  conceptId             String
  masteryDelta          Float?
  misconceptionResolved Boolean  @default(false)
  hintsUsed             Int      @default(0)
  questionsAnswered     Int      @default(0)
  teachBackScore        Float?
  completedAt           DateTime @default(now())

  session TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  concept Concept      @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@map("tutor_session_outcomes")
}

// ---------------------------------------------------------------------------
// Exam & assessment engine (Phase 8)
//
// An Exam is both the "ExamConfig" and "ExamSession" the spec describes
// (spec §4, §17) — a real MVP has no reason to split configuration from
// the session it configures, and each Exam row already doubles as its own
// ExamAttempt history record (spec §48) once graded, so a separate
// ExamAttempt model would just duplicate it. ExamQuestion is deliberately
// its own model rather than reusing Question (Phase 5): exam questions
// need a response-format axis (multiple choice options, correct option
// ids for deterministic grading) that free-text Active Recall questions
// don't have, but question GENERATION reuses the same Claude-calling
// infrastructure (extractStructured/withRetry) and source-grounding
// conventions as question-generator.ts (spec §7 — no separate pipeline).
// Grading, mastery, prerequisite, and difficulty logic are never
// reimplemented here — see exam-grader.ts / mistake-analyzer.ts /
// exam-readiness.ts / adaptive-exam.ts for what's reused from Phases
// 4/5/6 instead (spec §13, §55, §60).
// ---------------------------------------------------------------------------

enum ExamMode {
  WRITTEN
  ORAL
  SCENARIO
  ADAPTIVE
}

enum ExamStatus {
  CREATED
  ACTIVE
  PAUSED
  SUBMITTED
  GRADED
  EXPIRED
  ABANDONED
}

/// FIXED uses `difficulty` for every question; ADAPTIVE lets adaptive-exam.ts adjust difficulty question-to-question (spec §12).
enum ExamDifficultyMode {
  FIXED
  ADAPTIVE
}

model Exam {
  id       String     @id @default(cuid())
  userId   String
  courseId String
  mode     ExamMode
  status   ExamStatus @default(CREATED)

  difficultyMode   ExamDifficultyMode @default(FIXED)
  /// Base/starting difficulty (1-5) — the only meaning for FIXED mode; the seed difficulty for ADAPTIVE mode.
  difficulty       Int                @default(2)
  questionCount    Int
  timeLimitSeconds Int?
  /// 0-1; a graded Exam is `passed` when ExamResult.percentage >= this (spec §4, §37).
  passingScore     Float              @default(0.75)
  allowHints       Boolean            @default(false)
  allowSources     Boolean            @default(false)

  /// Concept ids explicitly requested for this exam (e.g. a retest); null/empty means "the whole course" via the blueprint (spec §4, §46).
  targetConceptIds Json?
  /// The generated ExamBlueprint snapshot (concept weights, cognitive distribution) — kept for audit/UI, never recomputed differently after creation (spec §5-6).
  blueprint        Json?
  /// True for a RETEST_WEAK_AREAS exam (spec §46) — informs the UI and excludes it from certain readiness aggregates that expect full-coverage exams.
  isRetest         Boolean @default(false)

  currentQuestionIndex Int       @default(0)
  startedAt            DateTime?
  submittedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  answers   ExamAnswer[]
  result    ExamResult?

  @@index([userId, courseId])
  @@index([userId, status])
  @@map("exams")
}

enum ExamQuestionType {
  MULTIPLE_CHOICE
  MULTI_SELECT
  TRUE_FALSE
  SHORT_ANSWER
  OPEN_ENDED
  PROBLEM_SOLVING
  SCENARIO
  TEACH_BACK
}

/// Bloom's-taxonomy-inspired cognitive dimension (spec §35-36) — independent of questionType (response format) and difficulty (1-5 hardness).
enum CognitiveLevel {
  RECALL
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
}

model ExamQuestion {
  id        String @id @default(cuid())
  examId    String
  conceptId String

  questionType   ExamQuestionType
  cognitiveLevel CognitiveLevel
  difficulty     Int              @default(2)
  /// 1-based order within the exam.
  position       Int

  prompt                 String
  /// MULTIPLE_CHOICE/MULTI_SELECT/TRUE_FALSE only: [{id, text}]. Never includes which option is correct — see correctOptionIds.
  options                Json?
  /// Option ids that grade as correct — never sent to the client while the exam is ACTIVE (spec §53).
  correctOptionIds       Json?
  /// Reference answer for SHORT_ANSWER/OPEN_ENDED/PROBLEM_SOLVING/SCENARIO/TEACH_BACK grading context — never shown before submission (spec §14, §63).
  expectedAnswer         String?
  /// AssessmentRubric criteria: [{criterion, weight, description}] (spec §22).
  rubric                 Json?
  /// Document chunk ids this question is grounded in (spec §9, §62).
  sourceReferences       Json?
  /// Direct prerequisite concept ids, snapshotted at generation time — used by mistake-analyzer.ts without re-querying the graph for display purposes (spec §8, §26).
  prerequisiteConceptIds Json?
  learningObjective      String?
  points                 Float   @default(1)

  /// SCENARIO only: context/objective/constraints/availableInformation (spec §32-33) — kept separate from `prompt` (the actual question) so the UI can render them distinctly.
  scenario Json?

  createdAt DateTime @default(now())

  exam    Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  concept Concept     @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  answer  ExamAnswer?

  @@index([examId])
  @@index([conceptId])
  @@map("exam_questions")
}

enum ExamAnswerClassification {
  CORRECT
  PARTIALLY_CORRECT
  INCORRECT
  MISCONCEPTION
  UNANSWERED
}

/// Independent of StudentMistakeCategory (Phase 4) — an exam-specific taxonomy (spec §24) mapped down to the closest StudentMistakeCategory when persisted into StudentMistake via recordLearningOutcome, so exam mistakes still show up in the one cross-phase mistake history rather than a second, disconnected one.
enum ExamMistakeCategory {
  KNOWLEDGE_GAP
  MISCONCEPTION
  RECALL_FAILURE
  REASONING_FAILURE
  APPLICATION_FAILURE
  PREREQUISITE_FAILURE
  CARELESS_ERROR
  INCOMPLETE_ANSWER
  TIME_PRESSURE
  UNKNOWN
}

/// Student self-report (spec §19) — illusion-of-competence detection (spec §22) is INCORRECT + CONFIDENT.
enum ExamConfidenceLevel {
  CONFIDENT
  UNSURE
  GUESSING
}

model ExamAnswer {
  id         String @id @default(cuid())
  examId     String
  questionId String @unique
  userId     String

  /// SHORT_ANSWER/OPEN_ENDED/PROBLEM_SOLVING/SCENARIO/TEACH_BACK/ORAL free text.
  answerText        String?
  /// MULTIPLE_CHOICE/MULTI_SELECT/TRUE_FALSE selected option ids.
  selectedOptionIds Json?
  confidence        ExamConfidenceLevel?

  timeSpentSeconds Int     @default(0)
  hintsUsed        Int     @default(0)
  revealedAnswer   Boolean @default(false)
  /// ORAL only — the examiner depth this answer was given at (spec §30).
  oralDepth        Int?

  classification  ExamAnswerClassification?
  /// 0-1 deterministic final score — for open-ended/scenario/oral this is calculated by the backend from criteriaScores, never trusted directly from Claude (spec §22-23).
  score           Float?
  /// Claude's per-criterion scores for open-ended/scenario/oral grading (spec §21-22) — informational/auditable, not the source of truth for `score`.
  criteriaScores  Json?
  feedback        String?
  missingConcepts Json?
  mistakeCategory ExamMistakeCategory?
  mistakeSeverity MistakeSeverity?

  /// Set once recordLearningOutcome() has run for this answer (spec §23, §64).
  attemptId String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  exam     Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  question ExamQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt  LearningAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([examId])
  @@index([userId])
  @@map("exam_answers")
}

/// The graded aggregate for one Exam (spec §37-39) — written once, at submission. conceptScores/cognitiveScores/mistakeSummary come straight from the ExamAnswer rows, never invented.
model ExamResult {
  id     String @id @default(cuid())
  examId String @unique

  overallScore     Float
  percentage       Float
  passed           Boolean
  totalQuestions   Int
  correctAnswers   Int
  partialAnswers   Int
  incorrectAnswers Int
  unanswered       Int
  timeSpentSeconds Int

  /// { [conceptId]: { name, score, questionCount } }
  conceptScores   Json
  /// { [cognitiveLevel]: score }
  cognitiveScores Json
  /// { totalMistakes, byCategory: {...}, prerequisiteGaps: [...] }
  mistakeSummary  Json
  /// Snapshot of ExamReadinessEngine's output computed right after this exam (spec §40-41) — not recomputed later.
  readinessScore  Float?

  gradedAt DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@map("exam_results")
}

// ---------------------------------------------------------------------------
// Cost control / observability
// ---------------------------------------------------------------------------

/// Phase 12: usage/cost observability, not billing. `sessionId` is a plain
/// string (not a relation) since it can point at a TutorSession, StudySession,
/// or Exam depending on `requestType` — a single FK would couple this
/// cross-cutting log table to one domain model. `success=false` rows have
/// best-effort token counts (usually 0, since a failed call often produced
/// no usable `usage` payload) — `latencyMs` is still meaningful for those.
model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  sessionId        String?
  model            String
  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Float
  requestType      String
  latencyMs        Int?
  success          Boolean  @default(true)
  /// Coarse failure category (Phase 19 §19.14) — TIMEOUT/RATE_LIMIT/VALIDATION/PROVIDER/UNKNOWN, mirroring the
  /// error-architecture taxonomy from §19.4. Null when success is true. Lets an operator query "how many exam
  /// grading calls failed on rate limits this week" without a second telemetry system.
  errorType        String?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([sessionId])
  @@index([requestType])
  @@map("ai_usage_logs")
}

/// Phase 14 (TTS): usage/cost observability for speech synthesis, kept
/// deliberately separate from AiUsageLog rather than shoehorned into it —
/// TTS is billed per character, not per token, and has no natural
/// "inputTokens/outputTokens" shape, and spec §20 explicitly requires TTS
/// cost never be mixed into Claude token totals. `messageId` is a plain
/// string (not a relation) for the same cross-cutting-log reason
/// AiUsageLog's `sessionId` is — this log must survive if the underlying
/// TutorMessage is ever deleted.
model TtsUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  sessionId        String?
  messageId        String?
  provider         String
  model            String
  voice            String
  characterCount   Int
  estimatedCostUsd Float
  latencyMs        Int?
  /// True when this request was served from TutorMessageAudio instead of calling the provider (spec §9/§20-21).
  cacheHit         Boolean  @default(false)
  success          Boolean  @default(true)
  /// Coarse failure category (Phase 19 §19.14), same taxonomy as AiUsageLog.errorType. Null when success is true.
  errorType        String?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([messageId])
  @@index([createdAt])
  @@map("tts_usage_logs")
}

/// Persistent audio cache (spec §9) — one row per (message, voice, model,
/// exact text synthesized). Keyed by `textHash` rather than trusting
/// `messageId` alone, since a persisted TutorMessage's content is treated
/// here as *potentially* revisable even though nothing in this codebase
/// currently mutates one after creation — a changed message can never
/// silently serve stale audio. `storageKey` points into `audioStorage`
/// (src/lib/storage/audio-storage.ts), never a public URL.
model TutorMessageAudio {
  id             String   @id @default(cuid())
  messageId      String
  voice          String
  provider       String
  model          String
  textHash       String
  storageKey     String
  format         String
  characterCount Int
  createdAt      DateTime @default(now())

  message TutorMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, voice, model, textHash])
  @@index([messageId])
  @@map("tutor_message_audio")
}

// ---------------------------------------------------------------------------
// Study Advisor (Phase 15)
//
// Decides WHAT to study, WHEN, and HOW MUCH time to allocate — never HOW
// (that's the Tutor/Active Recall/Exam/Review, all reused unchanged as the
// roadmap's "action" targets). Knowledge-gap scoring is NOT reimplemented
// here: roadmap generation reuses Phase 6's calculateConceptValue() over a
// scope-filtered StudentLearningState (src/lib/advisor/knowledge-gaps.ts),
// so a StudyRoadmapItem's `reason` is grounded in the exact same weakness/
// prerequisite/forgetting-risk/goal-relevance numbers the adaptive engine
// already computes — never AI-fabricated statistics (spec §38).
//
// No separate "StudyAdvisorProfile" model: goal/deadline/time-budget input
// is advisor-specific and doesn't need to outlive one roadmap the way
// Phase 6's LearningGoal does (which stays untouched here), so those fields
// are stored directly on StudyRoadmap — see spec §23's own "avoid
// unnecessary duplication" / "do not over-model" guidance.
// ---------------------------------------------------------------------------

enum StudyRoadmapScopeType {
  COURSE
  FOLDER
  DOCUMENTS
}

enum StudyRoadmapStatus {
  ACTIVE
  /// Phase 16 §32 — no overdue penalties and no automatic-adaptation checks accrue while paused; progress is preserved as-is.
  PAUSED
  COMPLETED
  /// Superseded by a newer version via Replan (spec §36-37) — never deleted, so the original stays inspectable.
  ARCHIVED
}

/// Phase 16 §3 — why a given roadmap VERSION exists. INITIAL_GENERATION is
/// the only trigger that never has a `replacesRoadmapId`; every other value
/// always does.
enum AdaptationTrigger {
  INITIAL_GENERATION
  MISSED_SESSIONS
  LOW_PERFORMANCE
  DEADLINE_CHANGE
  KNOWLEDGE_CHANGE
  MANUAL_REPLAN
  TIME_AVAILABILITY_CHANGE
}

/// One planning cycle. Replanning never mutates or deletes an existing
/// roadmap (spec §36) — it creates a new row with `replacesRoadmapId`
/// pointing at the one it supersedes, and flips the old row's status to
/// ARCHIVED, so the full version history stays queryable.
///
/// Phase 16 keeps this full-snapshot versioning strategy rather than
/// switching to a delta/patch model: a roadmap's weeks/items are a few
/// dozen rows at most, so a delta representation would add real complexity
/// (reconstructing "current state" would require replaying patches) for no
/// measurable storage or performance benefit at this scale. What Phase 16
/// adds instead is richer *metadata* per version — why it exists
/// (`adaptationTrigger`/`adaptationReason`) and what changed
/// (`changeSummary`, computed deterministically by
/// src/lib/advisor/diff.ts) — without touching the versioning shape itself.
model StudyRoadmap {
  id       String @id @default(cuid())
  userId   String
  courseId String

  title         String
  /// Free-text goal, e.g. "Pass my Biology exam" (spec §22's own example) — deliberately not the enum-typed LearningGoal.type, since the Advisor's goal is a student-authored sentence, not a fixed category.
  goal          String
  targetScore   Float?
  deadline      DateTime?
  /// How many minutes/day the student says they can study — the deterministic time-budget input (spec §29).
  minutesPerDay Int
  /// Weekday indices (0=Sunday..6=Saturday) the student is available to study — an empty/omitted array means every day.
  studyDays     Json
  status        StudyRoadmapStatus @default(ACTIVE)

  scopeType     StudyRoadmapScopeType
  /// Set only when scopeType=FOLDER — the roadmap's traceable source scope (spec §19, §31), never just a display string.
  scopeFolderId String?

  /// AI-authored, but only ever generated from the compact deterministic context built in src/lib/advisor/context.ts — never from raw document text (spec §26).
  summary         String
  risks           Json
  recommendations Json

  version           Int     @default(1)
  /// The roadmap this one replaced via Replan — null for an original (non-replanned) roadmap.
  replacesRoadmapId String? @unique

  /// Why this specific version exists (Phase 16 §3) — INITIAL_GENERATION for the very first roadmap of a chain, otherwise the reason this version replaced the previous one.
  adaptationTrigger AdaptationTrigger @default(INITIAL_GENERATION)
  /// Short human-readable explanation shown to the student (Phase 16 §44) — e.g. "Your recent Genetics accuracy dropped to 44%." Null for the initial version.
  adaptationReason  String?
  /// Deterministic diff vs the roadmap this one replaced (Phase 16 §27) — {removed, movedEarlier, added}, never a raw DB diff. Null for the initial version.
  changeSummary     Json?
  /// Last time checkAdaptationNeeded() evaluated this roadmap (Phase 16 §21-22) — windows "new evidence since" so the same evidence is never double-counted across checks.
  lastEvaluatedAt   DateTime?

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scopeFolder     Folder?                @relation(fields: [scopeFolderId], references: [id], onDelete: SetNull)
  scopeDocuments  StudyRoadmapDocument[]
  weeks           StudyRoadmapWeek[]
  items           StudyRoadmapItem[]
  replacesRoadmap StudyRoadmap?          @relation("RoadmapVersion", fields: [replacesRoadmapId], references: [id], onDelete: SetNull)
  replacedBy      StudyRoadmap?          @relation("RoadmapVersion")

  @@index([userId, courseId])
  @@index([userId, status])
  @@map("study_roadmaps")
}

/// Persists the exact document set for a DOCUMENTS-scoped roadmap (spec
/// §19, §31) — relational, not a display string, so the scope can always be
/// securely reconstructed and re-verified against the owning user.
model StudyRoadmapDocument {
  id         String @id @default(cuid())
  roadmapId  String
  documentId String

  roadmap  StudyRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  document Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, documentId])
  @@index([roadmapId])
  @@map("study_roadmap_documents")
}

/// One AI-chosen planning week (spec §33-34) — `focusSummary`/`reason` are
/// the AI's own weekly narrative (spec §27 explicitly reserves "study
/// strategy"/"rationale" for the AI); `estimatedMinutes` is validated/
/// clamped server-side against the deterministic time budget before
/// persisting (spec §29 — a generated plan must never exceed it).
model StudyRoadmapWeek {
  id               String   @id @default(cuid())
  roadmapId        String
  weekNumber       Int
  startDate        DateTime
  endDate          DateTime
  focusSummary     String
  reason           String
  estimatedMinutes Int

  roadmap StudyRoadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  items   StudyRoadmapItem[]

  @@unique([roadmapId, weekNumber])
  @@index([roadmapId])
  @@map("study_roadmap_weeks")
}

enum StudyRoadmapItemAction {
  LEARN
  REVIEW
  PRACTICE
  ACTIVE_RECALL
  SPACED_REPETITION
  TUTOR
  EXAM_PRACTICE
}

enum StudyRoadmapItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

/// One executable line of the daily/weekly plan (spec §32-33). `reason` is
/// composed deterministically server-side from the same evidence
/// calculateConceptValue() already surfaces (spec §38 — "prioritized
/// because your recent accuracy is 48%" must be a real number, never an AI
/// guess). `baselineMastery` snapshots this concept's overallMastery at
/// generation time so progress (spec §35) can measure real improvement,
/// not just item-completion ratio. `sourceDocumentId` is set only when the
/// concept's strongest evidence traces to one specific document (spec §20)
/// — left null rather than fabricated when the recommendation comes from
/// aggregated knowledge data instead.
model StudyRoadmapItem {
  id        String  @id @default(cuid())
  roadmapId String
  weekId    String?
  conceptId String?

  action           StudyRoadmapItemAction
  title            String
  estimatedMinutes Int
  priority         Float
  reason           String
  scheduledDate    DateTime?
  status           StudyRoadmapItemStatus @default(PENDING)
  completedAt      DateTime?
  isMilestone      Boolean                @default(false)
  baselineMastery  Float?
  sourceDocumentId String?
  /// True when this item was copied forward from a previous roadmap version's already-COMPLETED work (Phase 16 §26) rather than newly generated — preserves visible continuity ("Algebra Basics ✓") instead of burying completed history in an archived roadmap.
  carriedForward   Boolean                @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roadmap        StudyRoadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  week           StudyRoadmapWeek? @relation(fields: [weekId], references: [id], onDelete: SetNull)
  concept        Concept?          @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  sourceDocument Document?         @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([roadmapId])
  @@index([weekId])
  @@index([roadmapId, scheduledDate])
  @@index([conceptId])
  @@map("study_roadmap_items")
}
