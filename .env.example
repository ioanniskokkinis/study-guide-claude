# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://study_coach:study_coach_dev_password@localhost:5432/study_coach?schema=public"
# Used only by `prisma migrate dev` for drift detection; requires the pgvector
# extension to be pre-installed since the app role isn't a Postgres superuser.
SHADOW_DATABASE_URL="postgresql://study_coach:study_coach_dev_password@localhost:5432/study_coach_shadow?schema=public"

# Server-side only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
ANTHROPIC_API_KEY=""

# Model selection (spec §26 — configurable, cheap model for simple tasks,
# stronger model for hard reasoning).
ANTHROPIC_MODEL_DEFAULT="claude-sonnet-5"
ANTHROPIC_MODEL_FAST="claude-haiku-4-5-20251001"

# Local filesystem storage root for uploaded documents (Phase 2+).
STORAGE_ROOT="./storage/uploads"

# Upload + chunking configuration (Phase 2).
MAX_UPLOAD_SIZE_MB="50"
DOCUMENT_CHUNK_SIZE="1200"
DOCUMENT_CHUNK_OVERLAP="150"

# Single-user development stand-in until real auth ships. All courses are
# scoped to this user.
DEV_USER_EMAIL="dev@studycoach.local"

# Phase 5 — which model tier ("fast" or "default", see ANTHROPIC_MODEL_*
# above) each AI task uses.
AI_MODEL_QUESTION_GENERATION="fast"
AI_MODEL_ANSWER_EVALUATION="default"
AI_MODEL_HINT_GENERATION="fast"

# Phase 5 — default number of questions in an Active Recall session.
DEFAULT_RECALL_SESSION_LENGTH="10"

# Phase 12 (AI cost & token optimization) — explicit output-token ceilings
# per operation family; see src/lib/ai/token-budgets.ts for exactly which
# Claude call maps to which budget. All optional — shown here with their
# defaults.
AI_HINT_MAX_TOKENS="200"
AI_TUTOR_MAX_TOKENS="500"
AI_EVALUATION_MAX_TOKENS="1000"
AI_EXAM_MAX_TOKENS="1600"

# Phase 12 — Tutor conversation context bounds. AI_CONTEXT_RECENT_MESSAGES
# turns are sent to Claude verbatim; once a session's total message count
# exceeds AI_CONTEXT_MAX_MESSAGES, everything older is replaced by a
# deterministic (non-AI) summary instead of being silently dropped.
AI_CONTEXT_RECENT_MESSAGES="6"
AI_CONTEXT_MAX_MESSAGES="12"

# Phase 14 (TTS / Voice Tutor) — off by default. With TTS_ENABLED="false" (or
# unset), no TTS provider is ever constructed and no TTS request is ever
# made; the text Tutor works completely unaffected.
TTS_ENABLED="false"
TTS_PROVIDER="openai"
TTS_MODEL="tts-1"
TTS_VOICE="alloy"
# Server-side only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
TTS_API_KEY=""
# Local filesystem root for generated Tutor audio — separate from
# STORAGE_ROOT (uploaded course documents).
AUDIO_STORAGE_ROOT="./storage/audio"
# A Tutor message's cleaned speech text longer than this is split at
# sentence boundaries rather than sent to the provider in one huge request.
TTS_MAX_CHARACTERS="2000"

# Phase 15 (Study Advisor) — which model tier the roadmap-generation call
# uses, and its output-token ceiling (see src/lib/ai/token-budgets.ts).
AI_MODEL_STUDY_ADVISOR="default"
AI_STUDY_ADVISOR_MAX_TOKENS="2500"

# Phase 19 (production readiness) — explicit per-category timeout ceilings
# for every remaining Claude call site (see src/lib/ai/timeout-budgets.ts).
# Generalizes the pattern AI_ACTIVE_RECALL_EVALUATION_TIMEOUT_MS established
# for just one call site: before this, 18 of 19 distinct call sites had no
# application-level timeout at all.
AI_HINT_TIMEOUT_MS="15000"
AI_TUTOR_TIMEOUT_MS="20000"
AI_EVALUATION_TIMEOUT_MS="20000"
AI_EXAM_TIMEOUT_MS="25000"
AI_STUDY_ADVISOR_TIMEOUT_MS="45000"
AI_QUESTION_GENERATION_TIMEOUT_MS="20000"
AI_KNOWLEDGE_EXTRACTION_TIMEOUT_MS="30000"
